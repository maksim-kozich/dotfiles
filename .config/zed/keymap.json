// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
[
  {
    // JetBrains keymap binds cmd-~ to git::Branch; give it back to macOS (cycle windows backwards)
    "bindings": {
      "cmd-~": null
    }
  },
  {
    // PyCharm-style compare of two selected files in the project panel
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "cmd-d": "project_panel::CompareMarkedFiles"
    }
  }
]
