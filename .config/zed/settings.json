// Zed settings — only values that differ from the defaults.
// See all defaults: command palette → `zed: open default settings`
{
  // behavior
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "disable_ai": true,
  "autosave": "on_focus_change",
  "cli_default_open_behavior": "new_window",
  "session": { "trust_all_worktrees": true },

  // look
  "theme": "JetBrains Islands Dark",
  "unstable.ui_density": "compact",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_features": { "calt": false },
  "buffer_font_size": 13,
  "buffer_line_height": { "custom": 1.3 },
  "toolbar": { "breadcrumbs": false, "quick_actions": false, "selections_menu": false },

  // panels on the left, PyCharm style
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false,
    "entry_spacing": "standard",
    "git_status": false,
    "git_status_indicator": true
  },
  "git_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },

  // git
  "git": { "inline_blame": { "enabled": false } }
}
