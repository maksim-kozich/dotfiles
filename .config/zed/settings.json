// Zed settings — only values that differ from the defaults.
// See all defaults: command palette → `zed: open default settings`
{
  // Panel Layou,
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false,
    // "git_status": false,
    "git_status_indicator": true,
    "show_diagnostics": "off"
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": true,


  // behavior
  "vim_mode": true,
  "cli_default_open_behavior": "new_window",
  // "base_keymap": "JetBrains",
  // "helix_mode": true,
  // "vim_mode": false,
  "format_on_save": "off",

  // look
  "unstable.ui_density": "compact",
  "theme": "One Dark",
  // "theme": "JetBrains Islands Dark",
  // "icon_theme": "JetBrains New UI Icons (Dark)",
  // "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_features":   { "calt": false },
  "buffer_font_size": 13,
  "buffer_line_height": "standard",
  "toolbar": { "breadcrumbs": true, "quick_actions": false },
  // "gutter": {
  //   "line_numbers": false
  // },

  // git
  "git": { "inline_blame": { "enabled": false } }
}
